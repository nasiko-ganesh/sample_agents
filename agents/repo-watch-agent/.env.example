OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
GITHUB_TOKEN=ghp_...
# Space-separated watch list, used when a query doesn't name any repos itself
# (e.g. a scheduled "check for updates" call with no repo mentioned).
GITHUB_REPO=Nasiko-Labs/nasiko-cloud-rs Nasiko-Labs/nasiko-rs
PORT=8000

# Slack bot token (needs files:write + channels:read scopes) and the channel to post the
# scheduled/on-demand digest to.
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C012-....
# HH:MM, interpreted in IST (Asia/Kolkata). Optional — defaults to 07:30 / 19:30.
DIGEST_MORNING_TIME=07:30
DIGEST_EVENING_TIME=19:30
